# ---- Database ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/video_discovery

# ---- Meta / Instagram ----
# Meta Ad Library API (Graph API) - requires an app + access token with ads_read
META_ACCESS_TOKEN=
META_AD_LIBRARY_COUNTRY=IN
# Hard cap on real HTTP calls to Meta in ONE search (shared across the
# query-widening loop) -- protects against a pagination bug burning quota.
META_MAX_REQUESTS_PER_SEARCH=10

# Instagram source. Two interchangeable methods -- see README's "Video
# sourcing" section for what was actually verified against each:
#   "rapidapi" - "Instagram Scraper Stable API" on RapidAPI
#                (instagram-scraper-stable-api.p.rapidapi.com),
#                GET /search_hashtag.php?hashtag=<tag>. Swap host/key for a
#                different RapidAPI provider if its response shape differs
#                -- see app/services/sources/instagram.py for the mapping.
#   "browser"  - Playwright + headless Chromium against Instagram's own
#                hashtag explore page, no API key needed (run
#                `playwright install chromium` once). See
#                app/services/sources/instagram_browser.py.
INSTAGRAM_PROVIDER=rapidapi
INSTAGRAM_API_KEY=
INSTAGRAM_API_HOST=instagram-scraper-stable-api.p.rapidapi.com
# Hard cap on real HTTP calls to Instagram in ONE search (shared across the
# query-widening loop), only relevant to INSTAGRAM_PROVIDER=rapidapi. Keep
# this LOW on a free-tier plan -- many RapidAPI Instagram scrapers cap at
# ~20 requests/MONTH, not per day.
INSTAGRAM_MAX_REQUESTS_PER_SEARCH=3

# ---- TikTok (optional bonus source) ----
TIKTOK_ENABLED=false
TIKTOK_API_KEY=

# ---- Image analysis brain ----
# "openai" (uses OPENAI_API_KEY + vision model) or "local_clip" (uses open_clip, no key needed)
VISION_PROVIDER=local_clip
OPENAI_API_KEY=

# ---- Match scoring ----
MATCH_SCORE_THRESHOLD=55

# ---- App ----
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
